# Optional: overrides the committed public ODPT key. Obtain your own at
# https://developer.odpt.org/ when needed.
ODPT_CONSUMER_KEY=
# Override for restricted datasets such as the Challenge 2026 JR East feed.
ODPT_ENDPOINT=
# Optional settings
ODPT_POLL_INTERVAL=30s
ODPT_HTTP_TIMEOUT=10s
# Display-only section-progress fallback before observed transitions exist.
# This is not a GPS measurement or physical arrival prediction.
SEGMENT_FALLBACK_DURATION=150s
# Maximum provider-observed durations retained per directed station section.
SEGMENT_HISTORY_SIZE=32
# Comma-separated development origins, or * (default).
CORS_ALLOWED_ORIGINS=http://localhost:5173
